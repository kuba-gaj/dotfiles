// KUB-118: rendered by omarchy-theme-set-templates → ~/.local/state/omarchy/current/theme/zen-user.js,
// symlinked as <zen profile>/user.js (read at every start, never written by Zen).
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true); // enables chrome/userChrome.css
user_pref("browser.tabs.inTitlebar", 0);                                 // no CSD title bar / buttons under Hyprland
user_pref("zen.theme.accent-color", "{{ accent }}");                     // accent where CSS vars don't reach
