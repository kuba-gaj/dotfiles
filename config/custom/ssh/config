{{#if is_macos}}Include {{home_dir}}/.config/colima/ssh_config

{{/if}}# Host-specific blocks must come before Host * (first match wins in SSH config)
{{#if mac_host}}
# Work mac on the home LAN (kubas-mac). Pinned to one key: the 1Password agent
# holds 6 and macOS sshd cuts off after MaxAuthTries.
Host mac
  HostName {{mac_host}}
  AddressFamily inet
  User {{mac_user}}
  IdentityFile ~/.ssh/kuba.dev.pub
  IdentitiesOnly yes

{{/if}}
{{#if is_macos}}
# Headless git on the mac (KUB-140): file keys only. ssh offers agent-held keys
# before file keys, and the 1Password agent cannot prompt on the invisible
# screen, so no agent-held identity may appear for github hosts here.
Host github.com
  IdentityFile ~/.ssh/kuba.mac-agent-personal
  IdentitiesOnly yes

{{/if}}
Host github-swap
  HostName github.com
  User git
{{#if is_macos}}
  IdentityFile ~/.ssh/kuba.mac-agent
{{else}}
  IdentityFile ~/.ssh/kuba.swap.pub
{{/if}}
  IdentitiesOnly yes
  ControlMaster no
  ControlPath none

# Enable reusing connections
ControlMaster auto
ControlPath ~/.ssh/control-%C
ControlPersist yes

Host *
  # Safer default: trust new hosts, and update keys automatically
  StrictHostKeyChecking accept-new
  UpdateHostKeys yes
  HashKnownHosts yes
  TCPKeepAlive yes
  ServerAliveInterval 60
  ServerAliveCountMax 240
  IdentityAgent "{{op_agent_sock}}"
#  RemoteForward 52698 127.0.0.1:52698
#  ForwardAgent yes
{{#if is_macos}}

