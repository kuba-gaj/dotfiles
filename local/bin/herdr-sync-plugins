#!/bin/sh
# Install every herdr plugin listed in ~/.config/herdr/plugins.txt (OWNER/REPO[/SUBDIR][@REF])
# that is not installed yet. Install-only: remove extras with `herdr plugin uninstall`.
set -u
list="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/plugins.txt"
if ! installed=$(herdr plugin list 2>&1); then
  echo "herdr-sync-plugins: skipped ($(printf '%s' "$installed" | grep -o '"message":"[^"]*' | cut -c12- | cut -d. -f1))" >&2
  exit 0
fi
installed=$(printf '%s\n' "$installed" | grep -o 'github:[^@]*' | sed 's/^github://')
rc=0
grep -v '^\s*#' "$list" | grep -v '^\s*$' | while read -r entry; do
  src=${entry%@*}; ref=${entry#*@}; [ "$ref" = "$entry" ] && ref=
  if printf '%s\n' "$installed" | grep -qx "$src"; then
    echo "ok       $src"
  else
    echo "install  $entry"
    herdr plugin install "$src" ${ref:+--ref "$ref"} -y || { echo "FAILED   $src" >&2; exit 1; }
  fi
done || rc=1
exit $rc
