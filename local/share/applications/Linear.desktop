[Desktop Entry]
# KUB-118: shadows /usr/share/applications/Linear.desktop. GDK_BACKEND=x11 skips tao 0.34's forced Wayland
# header bar (GTK_CSD=0 is a no-op there). GTK_THEME: GTK-on-X11 has no XSettings here → ignores prefer-dark → WebKit renders light. Re-test native Wayland once linear-desktop-bin ships Tauri >= 2.12 (tao >= 0.36).
Categories=
Exec=env GDK_BACKEND=x11 GTK_THEME=Adwaita:dark linear-linux %U
StartupWMClass=linear-linux
Icon=linear-linux
Name=Linear
Terminal=false
Type=Application
